<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_surface">

    <!-- 지도/카메라 분할 가이드라인 (상단 44dp + 목적지카드 뒤 지도 시작 기준) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/midGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.32" />

    <!-- ── 목적지 입력 바 (최상단 고정 카드) ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/destinationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="44dp"
        app:cardBackgroundColor="@color/ss_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- 주황 핀 아이콘 -->
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_orange"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="16sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/destinationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="목적지를 말씀해주세요"
                    android:textColor="@color/ss_text_hint"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/destinationSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="까지 안전한 길 안내"
                    android:textColor="@color/ss_text_hint2"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 마이크 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/destMicButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🎙"
                android:textSize="18sp"
                android:contentDescription="목적지 음성 입력"
                android:padding="0dp"
                app:backgroundTint="#FF6B00"
                app:cornerRadius="22dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── 지도 영역 ── -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/destinationBar"
        app:layout_constraintBottom_toTopOf="@id/midGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 구분선 -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#FF6B00"
        android:alpha="0.3"
        app:layout_constraintTop_toTopOf="@id/midGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── 카메라 + 오버레이 영역 ── -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 카메라 프리뷰 -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 세그멘테이션 오버레이 -->
        <ImageView
            android:id="@+id/segmentOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0.55"
            android:background="@android:color/transparent" />

        <!-- 바운딩박스 오버레이 -->
        <com.safestep.app.BoundingBoxOverlay
            android:id="@+id/bboxOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 코너 브래킷 (좌상단) -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/corner_tl"
            android:importantForAccessibility="no" />

        <!-- 코너 브래킷 (우상단) -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/corner_tr"
            android:importantForAccessibility="no" />

        <!-- 코너 브래킷 (좌하단) -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/corner_bl"
            android:importantForAccessibility="no" />

        <!-- 코너 브래킷 (우하단) -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/corner_br"
            android:importantForAccessibility="no" />

        <!-- 좌상단: 신호/보행 정보 카드 -->
        <LinearLayout
            android:id="@+id/signalInfoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_orange"
                android:gravity="center"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶"
                    android:textSize="14sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/signalDistText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="신호등 --"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/signalSafeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인전도 --%"
                    android:textColor="@color/ss_text_hint"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 우상단: 날씨 카드 -->
        <LinearLayout
            android:id="@+id/weatherCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#EEFFFFFF"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°C"
                android:textColor="@color/ss_text_field"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 성능 통계 오버레이 (우하단) -->
        <TextView
            android:id="@+id/statsOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:text=""
            android:textColor="#B3FF6B00"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:background="#99000000"
            android:padding="5dp"
            android:lineSpacingExtra="1dp"
            android:visibility="visible"
            android:importantForAccessibility="no" />

        <!-- 뒤로가기 버튼 (좌상단, 코너 브래킷 안쪽) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToModeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:layout_margin="36dp"
            android:text="←"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:contentDescription="모드 선택으로 돌아가기"
            android:padding="0dp"
            app:backgroundTint="#CC000000"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp" />

        <!-- 위험 경고 배너 -->
        <LinearLayout
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#EFFF6B00"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_white" />

            <TextView
                android:id="@+id/warningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앞에 사람 접근 중"
                android:textColor="@color/ss_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </LinearLayout>

    </FrameLayout>

    <!-- ── 하단 내비게이션 안내 카드 ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/ss_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:gravity="center_vertical">

            <!-- 주황 원형 방향 화살표 -->
            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_orange"
                android:gravity="center"
                android:layout_marginEnd="14dp">
                <TextView
                    android:id="@+id/navArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑"
                    android:textSize="24sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 거리 + 안내 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FF6B00"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/navInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="경로를 설정해주세요"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- 안내 듣기 버튼 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/navStepCount"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="🔊"
                    android:textSize="18sp"
                    android:contentDescription="안내 듣기"
                    android:padding="0dp"
                    app:backgroundTint="#FF6B00"
                    app:cornerRadius="22dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="안내 듣기"
                    android:textColor="@color/ss_text_secondary"
                    android:textSize="9sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── 하단 탭바 ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomTabBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ss_surface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
