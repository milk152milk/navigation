<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ss_surface">

    <!-- ── 본문 (스크롤 가능) ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ── 로고 영역 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="16dp">

                <!-- 오렌지 발자국 아이콘 -->
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_orange"
                    android:gravity="center"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_footprint"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SafeStep"
                        android:textColor="#FF6B00"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:contentDescription="SafeStep, 시각장애인을 위한 AI 안내 앱" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="AI가 안전한 길을 안내해드릴게요."
                        android:textColor="@color/ss_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── 일러스트 영역 ── -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/illust_home"
                android:scaleType="centerCrop"
                android:contentDescription="안전한 보행 환경 일러스트"
                android:background="@color/ss_orange_light" />

            <!-- ── 서버 URL 카드 ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/urlCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="서버 연결 상태"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/connectionDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_white"
                            android:backgroundTint="#888888"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/connectionStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="확인 중..."
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ss_divider"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVER URL"
                        android:textColor="#FF6B00"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <EditText
                        android:id="@+id/serverUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:hint="https://xxxx.ngrok-free.app/detect"
                        android:textColorHint="@color/ss_text_hint2"
                        android:textColor="@color/ss_text_field"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:background="@null"
                        android:contentDescription="서버 URL 입력. ngrok 또는 로컬 서버 주소를 입력하세요." />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 모드 선택 타이틀 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="10dp"
                android:text="모드를 선택하세요"
                android:textColor="@color/ss_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 카메라 모드 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/startButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="카메라 모드. 실시간 카메라로 위험 탐지 및 내비게이션을 시작합니다.">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_orange"
                        android:gravity="center"
                        android:layout_marginEnd="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷"
                            android:textSize="20sp"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="카메라 모드"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="실시간으로 주변 보행 환경을 분석해 안전한 길을 안내해요."
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#FF6B00"
                        android:textSize="26sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 동영상 테스트 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/ss_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/videoTestButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="동영상 테스트 모드. 저장된 동영상으로 탐지를 테스트합니다.">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_orange"
                        android:gravity="center"
                        android:layout_marginEnd="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="동영상 테스트"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="저장된 동영상을 선택해 AI 분석을 테스트해보세요."
                            android:textColor="@color/ss_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#FF6B00"
                        android:textSize="26sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 크레딧 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="powered by AI  ·  SafeStep"
                android:textColor="@color/ss_text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:importantForAccessibility="no" />

        </LinearLayout>
    </ScrollView>

    <!-- ── 하단 탭바 ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ss_surface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
