<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ss_surface">

    <!-- ── 상단 헤더 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="8dp"
        android:background="@color/ss_surface">

        <!-- 뒤로가기 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToModeButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/ss_text_field"
            android:contentDescription="모드 선택으로 돌아가기"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#10000000"
            app:cornerRadius="20dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="동영상 선택"
            android:textColor="@color/ss_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- ── 동영상 + 오버레이 영역 ── -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!-- 동영상 플레이어 -->
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- 노면 세그멘테이션 마스크 오버레이 -->
        <ImageView
            android:id="@+id/segmentOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0.6"
            android:background="@android:color/transparent" />

        <!-- 바운딩박스 오버레이 -->
        <com.safestep.app.BoundingBoxOverlay
            android:id="@+id/bboxOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 동영상 미선택 안내 (일러스트 스타일) -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/ss_surface">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:src="@drawable/illust_video"
                android:scaleType="fitCenter"
                android:contentDescription="동영상 AI 분석 일러스트" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="동영상을 선택해주세요"
                android:textColor="@color/ss_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:text="아래 버튼을 눌러 동영상을 불러오면&#10;AI가 자동으로 분석을 시작합니다."
                android:textColor="@color/ss_text_hint"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- 위험 경고 배너 (하단) -->
        <LinearLayout
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#EFFF6B00"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_white" />

            <TextView
                android:id="@+id/warningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="앞에 사람 접근 중"
                android:textColor="@color/ss_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- ── 하단 컨트롤 영역 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ss_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <!-- 탐지 상태 텍스트 -->
        <TextView
            android:id="@+id/detectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="동영상을 선택하면 탐지가 시작됩니다"
            android:textColor="@color/ss_text_hint"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3" />

        <!-- SeekBar 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/ss_text_hint"
                android:minWidth="34dp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:progressTint="#FF6B00"
                android:thumbTint="#FF6B00" />

            <TextView
                android:id="@+id/totalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/ss_text_hint"
                android:minWidth="34dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 동영상 선택 버튼 (아웃라인) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectVideoButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
       