<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ss_bg">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ss_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textColor="@color/ss_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="앱 환경을 설정하세요"
            android:textColor="@color/ss_text_hint"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- ══ 화면 설정 ══ -->
            <TextView style="@style/SectionLabel" android:text="화면 설정" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <!-- 다크/라이트 모드 -->
                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="화면 모드" />
                        <LinearLayout
                            android:id="@+id/toggleDarkMode"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/tmSystem" style="@style/ToggleBtn" android:text="시스템" />
                            <TextView android:id="@+id/tmLight"  style="@style/ToggleBtn" android:text="라이트" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/tmDark"   style="@style/ToggleBtn" android:text="다크"   android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 글자 크기 -->
                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="글자 크기" />
                        <LinearLayout
                            android:id="@+id/toggleTextSize"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/tsSmall"  style="@style/ToggleBtn" android:text="작게" />
                            <TextView android:id="@+id/tsNormal" style="@style/ToggleBtn" android:text="보통" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/tsLarge"  style="@style/ToggleBtn" android:text="크게" android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 화면 항상 켜기 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="화면 항상 켜기" />
                            <TextView style="@style/RowSub" android:text="보행 중 화면이 꺼지지 않아요" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchKeepScreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#FF6B00"
                            android:trackTint="#FFD5B0" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ 음성 안내 ══ -->
            <TextView style="@style/SectionLabel" android:text="음성 안내" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <!-- TTS 속도 -->
                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="음성 속도" />
                        <TextView
                            android:id="@+id/ttsSpeedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="보통"
                            android:textColor="#FF6B00"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />
                        <SeekBar
                            android:id="@+id/ttsSpeedSeek"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:max="4"
                            android:progress="2"
                            android:progressTint="#FF6B00"
                            android:thumbTint="#FF6B00" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 진동 알림 -->
                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="진동 알림" />
                        <Switch
                            android:id="@+id/vibrationSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#FF6B00"
                            android:trackTint="#FFD5B0" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 시작 안내음 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="시작 안내음" />
                            <TextView style="@style/RowSub" android:text="앱 실행 시 TTS 인사말" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchIntroSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#FF6B00"
                            android:trackTint="#FFD5B0" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ 탐지 설정 ══ -->
            <TextView style="@style/SectionLabel" android:text="탐지 설정" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <!-- 탐지 감도 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="탐지 감도" />
                            <TextView style="@style/RowSub" android:text="장애물 위험 판단 임계값" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/toggleSensitivity"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/sensSensitive" style="@style/ToggleBtn" android:text="민감" />
                            <TextView android:id="@+id/sensNormal"    style="@style/ToggleBtn" android:text="보통" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/sensBlunt"     style="@style/ToggleBtn" android:text="둔감" android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 경고 반복 간격 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="경고 반복 간격" />
                            <TextView style="@style/RowSub" android:text="같은 경고 재발화 대기 시간" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/toggleCooldown"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/cdShort"  style="@style/ToggleBtn" android:text="짧게" />
                            <TextView android:id="@+id/cdNormal" style="@style/ToggleBtn" android:text="보통" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/cdLong"   style="@style/ToggleBtn" android:text="길게" android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <!-- 탐지 속도 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="탐지 속도" />
                            <TextView style="@style/RowSub" android:text="빠를수록 배터리 사용량 증가" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/toggleFrameInterval"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/fiFast"   style="@style/ToggleBtn" android:text="빠름" />
                            <TextView android:id="@+id/fiNormal" style="@style/ToggleBtn" android:text="보통" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/fiSave"   style="@style/ToggleBtn" android:text="절약" android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ 내비게이션 ══ -->
            <TextView style="@style/SectionLabel" android:text="내비게이션" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <!-- 안내 시작 거리 -->
                    <LinearLayout style="@style/RowWrap">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/RowTitle" android:text="안내 시작 거리" />
                            <TextView style="@style/RowSub" android:text="경로 안내 발화 시점" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/toggleNavDist"
                            style="@style/ToggleGroup">
                            <TextView android:id="@+id/ndEarly"  style="@style/ToggleBtn" android:text="빠른 알림" />
                            <TextView android:id="@+id/ndNormal" style="@style/ToggleBtn" android:text="보통" android:layout_marginStart="4dp" />
                            <TextView android:id="@+id/ndLate"   style="@style/ToggleBtn" android:text="늦은 알림" android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ 서버 설정 ══ -->
            <TextView style="@style/SectionLabel" android:text="서버 설정" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="서버 연결 상태"
                            android:textColor="@color/ss_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_white"
                            android:backgroundTint="#22C55E"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="연결됨"
                            android:textColor="#22C55E"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View style="@style/Divider" android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVER URL"
                        android:textColor="#FF6B00"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <EditText
                        android:id="@+id/serverUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:hint="https://xxxx.ngrok-free.app/detect"
                        android:textColorHint="@color/ss_text_hint2"
                        android:textColor="@color/ss_text_field"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:background="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveUrlButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="저장"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#FF6B00"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ 앱 정보 ══ -->
            <TextView style="@style/SectionLabel" android:text="앱 정보" />

            <androidx.cardview.widget.CardView style="@style/SettingCard">
                <LinearLayout style="@style/CardInner">

                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="버전" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0.0"
                            android:textColor="@color/ss_text_hint"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View style="@style/Divider" />

                    <LinearLayout style="@style/RowWrap">
                        <TextView style="@style/RowTitle" android:text="만든이" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SafeStep Team"
                            android:textColor="@color/ss_text_hint"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 탭바 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ss_surface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
